# ==================== REACT APP CONFIGURATION ====================

# API Base URL - where the backend API server is running
# Development: Use relative path (proxy via Vite)
# Production: Use absolute URL to backend server
REACT_APP_API_URL=/api

# Optional: Specify the backend server URL for building/testing
# REACT_APP_BACKEND_URL=http://localhost:5000

# ==================== DEVELOPMENT VS PRODUCTION ====================
# Development (.env.development):
#   REACT_APP_API_URL=/api
#   (Vite will proxy to http://localhost:5000/api)
#
# Production (.env.production):
#   REACT_APP_API_URL=https://your-domain.com/api
#   (Direct calls to production backend)
#
# ==================== VITE DEVELOPMENT SERVER ====================
# By default, Vite runs on:
#   http://localhost:5173
#
# To enable API proxying, ensure vite.config.js has server.proxy configured
# pointing to your backend server (typically http://localhost:5000)
