# ==================== SERVER CONFIGURATION ====================
NODE_ENV=development
PORT=5000

# ==================== MONGODB CONFIGURATION ====================
# Replace with your MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/smartbin?retryWrites=true&w=majority
MONGODB_DB=smartbin

# ==================== MONGODB COLLECTIONS ====================
MONGO_COLLECTION_SENSORS=sensor_readings
MONGO_COLLECTION_MOTION=motion_events
MONGO_COLLECTION_STATUS=status_events
MONGO_COLLECTION_FALLBACK=raw_messages

# ==================== MQTT CONFIGURATION ====================
# MQTT broker URL (must match ESP32 config.h)
MQTT_URL=mqtt://broker.hivemq.com:1883

# MQTT topics to subscribe to (comma-separated, must match ESP32 topics)
MQTT_TOPICS=smartbin/sensors,smartbin/motion,smartbin/status

# Bridge client ID (unique identifier for MQTT subscriber)
BRIDGE_CLIENT_ID=smartbin_bridge_001

# ==================== ALERT THRESHOLDS ====================
# Configure alert triggers (must match ESP32 thresholds)
ALERT_FILL_THRESHOLD=85
ALERT_MOISTURE_THRESHOLD=70

# ==================== API PAGINATION ====================
# Default page size for /api/bins endpoint
BINS_PAGE_SIZE=50

# ==================== SETUP INSTRUCTIONS ====================
# 1. Get MONGODB_URI from MongoDB Atlas:
#    - Go to https://atlas.mongodb.com
#    - Create free Cluster (M0)
#    - Navigate to Databases > Connect > Connect Your App
#    - Copy connection string
#    - Replace <username>, <password>, and database name
#
# 2. Verify MQTT_URL matches your MQTT broker:
#    - Public test: mqtt://test.mosquitto.org:1883
#    - HiveMQ: mqtt://broker.hivemq.com:1883
#    - Local Mosquitto: mqtt://localhost:1883
#    - Must match MQTT_BROKER in ESP32 config.h
#
# 3. MQTT_TOPICS must match ESP32 #define statements:
#    - MQTT_TOPIC_SENSORS
#    - MQTT_TOPIC_MOTION
#    - MQTT_TOPIC_STATUS
#
# 4. Alert thresholds should match ESP32 config.h:
#    - ALERT_BIN_FULL_THRESHOLD
#    - ALERT_MOISTURE_HIGH_THRESHOLD

